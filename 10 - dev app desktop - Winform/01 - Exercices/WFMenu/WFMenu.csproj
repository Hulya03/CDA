<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WFAdditionneur\WFAdditionneur.csproj" />
    <ProjectReference Include="..\WFCheckBoxBoutonRadio\WFCheckBoxBoutonRadio.csproj" />
    <ProjectReference Include="..\WFDefilement\WFDefilement.csproj" />
    <ProjectReference Include="..\WFEmprunts\WFEmprunts.csproj" />
    <ProjectReference Include="..\WFListBoxCombobox\WFListBoxCombobox.csproj" />
    <ProjectReference Include="..\WFListeEtPropriete\WFListeEtPropriete.csproj" />
    <ProjectReference Include="..\WFNouvelleFenetre\WFNouvelleFenetre.csproj" />
    <ProjectReference Include="..\WFValidationSaisieEP\WFValidationSaisieEP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>